      "Bash(history -a*)",
      "Bash(history -n*)",
      "Bash(history -r*)",
      "Bash(history -w*)",
      "Bash(fc)",
      "Bash(fc *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/**/.env)",
      "Read(~/**/.env.*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./.git-credentials)",
      "Read(./.netrc)",
      "Read(./.pgpass)",
      "Read(./.npmrc)",
      "Read(./.pypirc)",
      "Read(./key.pem)",
