{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "日本語",
  "theme": "dark",
  "tui": "fullscreen",
  "model": "opus[1m]",
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    }
  },
  "alwaysThinkingEnabled": true,
  "autoMemoryEnabled": false,
  "showThinkingSummaries": true,
  "showClearContextOnPlanAccept": true,
  "agentPushNotifEnabled": true,
  "enableWorkflows": true,
  "plansDirectory": ".claude/plans",
  "cleanupPeriodDays": 20,
  "autoUpdatesChannel": "latest",
  "attribution": {
    "commit": ""
  },
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "enabledPlugins": {
    "context7@claude-plugins-official": true,
    "superpowers@claude-plugins-official": false
  },
  "skipWorkflowUsageWarning": true,
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(grep *)",
      "Bash(rg *)",
      "Bash(mkdir -p *)",
      "Bash(touch *)",
      "Bash(mv -i *)",
      "Bash(chmod *)",
      "Bash(git --version)",
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git config --list)",
      "Bash(git config --get *)",
      "Bash(git check-ignore *)",
      "Bash(GIT_TRACE_EXCLUDE=1 git status .claude)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git checkout -b *)",
      "Bash(git switch *)",
      "Bash(git restore --staged *)",
      "Bash(git commit *)",
      "Bash(gh auth status)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr checkout *)",
      "Bash(gh repo view *)",
      "Bash(npm view *)",
      "Bash(npm run build *)",
      "Bash(npm run lint *)",
      "Bash(npm run check-types *)",
      "Bash(npm run format:check *)",
      "Bash(npm run test *)",
      "Bash(npm run generate:icons *)",
      "Bash(pnpm run build *)",
      "Bash(pnpm run lint *)",
      "Bash(pnpm run check-types *)",
      "Bash(pnpm run format:check *)",
      "Bash(pnpm run test *)",
      "Bash(pnpm run generate:icons *)",
      "Bash(npx --no-install tsc *)",
      "Bash(npx --no-install prettier *)",
      "Bash(npx --no-install eslint *)",
      "Bash(npx --package=tailwindcss@^3.0.0 tailwindcss *)",
      "Bash(prettier --help)",
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.coderabbit.ai)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:www.radix-ui.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:releases.hashicorp.com)",
      "mcp__plugin_context7_context7"
    ],
    "deny": [
      "Bash(rm *)",
      "Bash(rm -rf *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(while *)",
      "Bash(until *)",
      "Bash(eval *)",
      "Bash(exec *)",
      "Bash(source *)",
      "Bash(. *)",
      "Bash(git rm *)",
      "Bash(git reset --hard *)",
      "Bash(git push --force)",
      "Bash(git push --force *)",
      "Bash(git push -f)",
      "Bash(git push -f *)",
      "Bash(git submodule add *)",
      "Bash(git submodule deinit *)",
      "Bash(git submodule rm *)",
      "Bash(gh auth login)",
      "Bash(gh auth logout)",
      "Bash(gh auth token)",
      "Bash(gh auth token *)",
      "Bash(gh auth status --show-token*)",
      "Bash(security *)",
      "Bash(op *)",
      "Bash(ghtkn *)",
      "Bash(docker-credential-*)",
      "Bash(aws-env)",
      "Bash(aws-env *)",
      "Bash(aws configure export-credentials*)",
      "Bash(aws sts get-session-token*)",
      "Bash(aws sts assume-role*)",
      "Bash(aws sts get-federation-token*)",
      "Bash(aws ecr get-login-password*)",
      "Bash(aws secretsmanager get-secret-value*)",
      "Bash(aws iam create-access-key*)",
      "Bash(aws eks get-token*)",
      "Bash(aws rds generate-db-auth-token*)",
      "Bash(aws kms decrypt*)",
      "Bash(aws sso get-role-credentials*)",
      "Bash(aws sso get-access-token*)",
      "Bash(aws sso-oidc create-token*)",
      "Bash(vault kv get*)",
      "Bash(vault read*)",
      "Bash(vault login*)",
      "Bash(vault token create*)",
      "Bash(gcloud auth print-access-token*)",
      "Bash(gcloud auth print-identity-token*)",
      "Bash(gcloud secrets versions access*)",
      "Bash(gcloud iam service-accounts keys create*)",
      "Bash(az account get-access-token*)",
      "Bash(az keyvault secret show*)",
      "Bash(az keyvault secret download*)",
      "Bash(kubectl get secret*)",
      "Bash(kubectl config view*)",
      "Bash(git credential fill*)",
      "Bash(git credential-*)",
      "Bash(gh auth git-credential*)",
      "Bash(printenv)",
      "Bash(printenv *)",
      "Bash(env)",
      "Bash(docker rm *)",
      "Bash(docker rmi *)",
      "Bash(docker volume rm *)",
      "Bash(docker volume prune *)",
      "Bash(docker system prune *)",
      "Bash(docker compose down -v)",
      "Bash(docker compose down -v *)",
      "Bash(npm ci *)",
      "Bash(npm uninstall *)",
      "Bash(npm update *)",
      "Bash(npm run dev *)",
      "Bash(npm run serve *)",
      "Bash(npm run start *)",
      "Bash(npm run storybook *)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm update *)",
      "Bash(pnpm dlx *)",
      "Bash(pnpm exec *)",
      "Bash(pnpm run dev *)",
      "Bash(pnpm dev *)",
      "Bash(pnpm run serve *)",
      "Bash(pnpm serve *)",
      "Bash(pnpm run start *)",
      "Bash(pnpm start *)",
      "Bash(pnpm run storybook *)",
      "Bash(pnpm storybook *)",
      "Bash(npx http-server *)",
      "Bash(npx serve *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.codex/auth.json)",
      "Read(~/.claude/.credentials.json)",
      "Read(~/.claude.json)",
      "Read(~/.claude.json.backup)",
      "Read(~/.claude/backups/**)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.kube/**)",
      "Read(~/.docker/config.json)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.netrc)",
      "Read(~/.git-credentials)",
      "Read(~/.pgpass)",
      "Read(~/.npmrc)",
      "Read(~/Library/Keychains/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/id_rsa)",
      "Read(**/id_rsa.pub)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "allowUnsandboxedCommands": false,
    "failIfUnavailable": true,
    "excludedCommands": [
      "terraform *",
      "terragrunt *",
      "docker *",
      "gh *",
      "git commit *",
      "git push *"
    ],
    "credentials": {
      "envVars": [
        {
          "name": "GH_TOKEN",
          "mode": "deny"
        },
        {
          "name": "GITHUB_TOKEN",
          "mode": "deny"
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "mode": "deny"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "mode": "deny"
        },
        {
          "name": "AWS_SESSION_TOKEN",
          "mode": "deny"
        },
        {
          "name": "NPM_TOKEN",
          "mode": "deny"
        },
        {
          "name": "ANTHROPIC_API_KEY",
          "mode": "deny"
        }
      ]
    },
    "filesystem": {
      "denyRead": [
        "~/.aws",
        "~/.ssh",
        "~/.codex/auth.json",
        "~/.claude/.credentials.json",
        "~/.claude.json",
        "~/.claude.json.backup",
        "~/.claude/backups",
        "~/.config/gh/hosts.yml",
        "~/.kube",
        "~/.docker/config.json",
        "~/.terraform.d/credentials.tfrc.json",
        "~/.netrc",
        "~/.git-credentials",
        "~/.pgpass",
        "~/Library/Keychains",
        "~/.gnupg"
      ]
    },
    "network": {
      "allowedDomains": [
        "github.com",
        "*.githubusercontent.com",
        "api.github.com",
        "registry.terraform.io",
        "*.terraform.io",
        "releases.hashicorp.com",
        "*.hashicorp.com",
        "registry.npmjs.org",
        "*.npmjs.org",
        "pypi.org",
        "*.pypi.org",
        "files.pythonhosted.org",
        "docs.anthropic.com",
        "code.claude.com",
        "*.amazonaws.com"
      ]
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-bash-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.claude/hooks/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  }
}
