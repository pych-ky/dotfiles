# Homebrew パッケージ

# OS 全体の CLI・GUI を管理。開発ツールは .config/mise/config.toml に集約
# 任意の GUI はコメントアウトを外し、brew bundle --file=macos/Brewfile で導入

## 外部 tap
tap "stablyai/orca"

## CLI

### シェル / ターミナル UX
brew "bash"
brew "fzf"
brew "starship"
brew "zoxide"

### 基本ユーティリティ
brew "coreutils"
brew "duti"
brew "gnu-sed"
brew "jq"
brew "ripgrep"
brew "tree"
brew "yq"

### Git / GitHub
brew "gh"
brew "ghq"
brew "gibo"
brew "git"
brew "git-lfs"
brew "lazygit"

### ランタイム / パッケージツール
brew "mise"
brew "uv"

### Lint / フォーマッタ
# secretlint は mise の公式バイナリを使用
brew "actionlint"
brew "shellcheck"
brew "shfmt"

### AI ツール
cask "copilot-cli"
brew "herdr"

### クラウド / IaC / ポリシー / Kubernetes
# aws / terraform / terragrunt / tflint は mise
brew "azure-cli"
cask "gcloud-cli"
brew "opa"
brew "openshift-cli"
brew "rosa-cli"
cask "session-manager-plugin"
brew "trivy"

### DB
# keg-only の psql 等は .zshrc で PATH に追加
brew "libpq"

## GUI アプリ

### ブラウザ
# cask "google-chrome"
cask "microsoft-edge"

### ターミナル
cask "ghostty"
cask "wezterm"

### 開発エディタ / AI ツール
cask "chatgpt"
# cask "claude"
