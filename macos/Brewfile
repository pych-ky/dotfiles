# ============================================================================
# Homebrew パッケージマニフェスト (brew bundle --file=macos/Brewfile で一括導入)
# ============================================================================
#
# 運用ルール:
# - 端末によって要否や導入手段が分かれる GUI アプリは、コメントアウトで
#   無効化してある。brew で導入したい端末ではコメントアウトを外して
#   brew bundle を再実行する
# - バージョン切り替えが必要な開発ランタイムは mise (.config/mise/config.toml)
#   で管理し、OS グローバルでよい CLI と GUI アプリだけをここで管理する

# ----------------------------------------------------------------------------
# サードパーティ tap
# ----------------------------------------------------------------------------
tap "terraform-linters/tap"

# ----------------------------------------------------------------------------
# CLI (formula)
# ----------------------------------------------------------------------------

# シェル / ターミナル UX
brew "bash"
brew "starship"
brew "fzf"
brew "zoxide"

# 基本ユーティリティ
brew "ripgrep"
brew "tree"
brew "jq"
brew "yq"
brew "shfmt"
brew "duti"

# Git / GitHub
brew "git"
brew "git-lfs"
brew "gibo"
brew "gh"
# secretlint は公式バイナリを mise 側で管理する

# ランタイム / パッケージツール
# node などのバージョン切り替えが必要なランタイムは mise 側で管理する
brew "mise"
brew "uv"

# クラウド / IaC / ポリシー / Kubernetes
# aws / terraform / terragrunt は mise (.config/mise/config.toml) が持ち主。
# ここでも宣言すると mise の shim が PATH 先頭に入って二重管理になるため置かない。
# kubectl / helm は Rancher Desktop 同梱 (~/.rd/bin) を使う
brew "opa"
brew "openshift-cli"
brew "rosa-cli"
brew "trivy"

# DB
# keg-only のため psql 等の PATH 追加は .zshrc 側で行う
brew "libpq"

# ----------------------------------------------------------------------------
# GUI アプリ (cask)
# ----------------------------------------------------------------------------

# ブラウザ
# cask "google-chrome"

# ターミナル
cask "wezterm"

# 開発エディタ / AI ツール
# cask "visual-studio-code" # 設定・拡張は VS Code Settings Sync 側で管理
# cask "claude"
cask "chatgpt"

# コミュニケーション / コラボレーション
# cask "slack"
cask "notion"

# 入力 / ウィンドウ管理
cask "karabiner-elements"
cask "typeless"
cask "rectangle"

# ユーティリティ
cask "appcleaner"
cask "licecap"
cask "logi-options+"

# セキュリティ / パスワード管理
# cask "1password"

# コンテナ / 仮想化 (docker / kubectl / helm の CLI は ~/.rd/bin 同梱)
cask "rancher"
# Rancher Desktop と競合するため、使う場合はどちらか一方にする
# cask "docker-desktop"

# IaC linter (cask 配布)
cask "terraform-linters/tap/tflint", trusted: true
