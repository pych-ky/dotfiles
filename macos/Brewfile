# Homebrew パッケージマニフェスト (brew bundle --file=macos/Brewfile で一括導入)
# 任意の GUI アプリを Homebrew で導入する場合は、コメントアウトを外して brew bundle を再実行する。
# OS 全体で使う CLI と GUI アプリをここで管理し、バージョン切り替えが必要なランタイムは mise (.config/mise/config.toml) で管理する。

# CLI (formula)

# シェル / ターミナル UX
brew "bash"
brew "starship"
brew "fzf"
brew "zoxide"

# 基本ユーティリティ
brew "ripgrep"
brew "tree"
brew "jq"
brew "yq"
brew "shfmt"

# Git / GitHub
brew "git"
brew "git-lfs"
brew "gibo"
brew "gh"
brew "ghq"
# secretlint は公式バイナリを mise 側で管理する

# ランタイム / パッケージツール
# node などのバージョン切り替えが必要なランタイムは mise 側で管理する
brew "mise"
brew "uv"

# クラウド / IaC / ポリシー / Kubernetes
# aws / terraform / terragrunt / tflint は mise 側で管理し、ここには重複して置かない
# kubectl / helm は Rancher Desktop 同梱 (~/.rd/bin) を使う
brew "azure-cli"
brew "opa"
brew "openshift-cli"
brew "rosa-cli"
brew "trivy"

# DB
# keg-only のため psql 等の PATH 追加は .zshrc 側で行う
brew "libpq"

# GUI アプリ (cask)

# ブラウザ
# cask "google-chrome"

# ターミナル
cask "ghostty"
cask "wezterm"

# 開発エディタ / AI ツール
# cask "visual-studio-code" # 設定・拡張は VS Code Settings Sync 側で管理
# cask "claude"
cask "chatgpt"

# コミュニケーション / コラボレーション
# cask "slack"
cask "notion"

# 入力 / ウィンドウ管理
cask "karabiner-elements"
cask "typeless"
cask "rectangle"

# ユーティリティ
cask "appcleaner"
cask "licecap"
cask "logi-options+"
cask "maccy"
cask "notunes"
cask "raycast"

# セキュリティ / パスワード管理
# cask "1password"

# コンテナ / 仮想化 (docker / kubectl / helm の CLI は ~/.rd/bin 同梱)
cask "rancher"
# Rancher Desktop と競合するため、使う場合はどちらか一方にする
# cask "docker-desktop"

# クラウド CLI (cask 配布)
cask "gcloud-cli"
cask "session-manager-plugin"
