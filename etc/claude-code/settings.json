      "Bash(gh auth status --show-token)",
      "Bash(docker-credential-*)",
      "Bash(kubectl get secret)",
      "Bash(kubectl get secrets)",
      "Bash(kubectl create token)",
      "Bash(kubectl config view --raw)",
      "Bash(printenv)",
      "Bash(env)",
      "Bash(npm config list)",
      "Bash(npm config ls)",
      "Bash(npm config get)",
      "Bash(npm c list)",
      "Bash(npm c ls)",
      "Bash(npm c get)",
      "Bash(npm con list)",
      "Bash(npm con ls)",
      "Bash(npm con get)",
      "Bash(npm conf list)",
      "Bash(npm conf ls)",
      "Bash(npm conf get)",
      "Bash(npm confi list)",
      "Bash(npm confi ls)",
      "Bash(npm confi get)",
      "Bash(npm g)",
      "Bash(npm ge)",
      "Bash(npm get)",
      "Bash(history)",
      "Bash(history --)",
      "Bash(history -a*)",
      "Bash(history -n*)",
      "Bash(history -r*)",
      "Bash(history -w*)",
      "Bash(fc)",
      "Bash(fc *)",
      "Read(./.env*)",
      "Read(~/**/.env*)",
      "Read(./secrets/**)",
      "Read(./credentials/**)",
      "Read(./.git-credentials)",
      "Read(./.netrc)",
      "Read(./.pgpass)",
      "Read(./.pypirc)",
      "Read(./key.pem)",
      "Read(~/**/secrets)",
      "Read(~/**/credentials)",
