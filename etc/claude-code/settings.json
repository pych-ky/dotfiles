{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 20,
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5",
    "CLAUDE_CODE_SUBAGENT_MODEL_FORCE": "1",
    "GIT_TERMINAL_PROMPT": "0",
    "PLAYWRIGHT_MCP_CDP_ENDPOINT": "msedge",
    "PLAYWRIGHT_MCP_OUTPUT_DIR": "/private/tmp/playwright-mcp",
    "PLAYWRIGHT_MCP_OUTPUT_MAX_SIZE": "52428800"
  },
  "attribution": {
    "commit": "",
    "sessionUrl": false
  },
  "autoMode": {
    "classifyAllShell": true
  },
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:docs.coderabbit.ai)",
      "WebFetch(domain:ui.shadcn.com)",
      "WebFetch(domain:www.radix-ui.com)",
      "WebFetch(domain:registry.terraform.io)",
      "WebFetch(domain:releases.hashicorp.com)"
    ],
    "deny": [
