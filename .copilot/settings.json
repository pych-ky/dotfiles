{
  "model": "claude-opus-5.5",
  "effortLevel": "max",
  "hooks": {
    "PreToolUse": [
      {
        "type": "command",
        "matcher": "Bash",
        "bash": "output=\"$(\"$HOME/.claude/hooks/pre-bash-guard.sh\")\" || exit 2; [ -z \"$output\" ] || { printf '%s\\n' \"$output\"; exit 2; }"
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "$HOME/.copilot/statusline.sh",
    "padding": 0,
    "refreshInterval": 10
  },
  "footer": {
    "showDirectory": false,
    "showBranch": false,
    "showQuota": true,
    "showYolo": true
  }
}
