#!/usr/bin/env bash
# 非公開文字列の検査フック

set -uo pipefail

mode="${1:-}"
remote_name="${2:-}"
remote_url="${3:-}"
if [[ "$mode" != pre-commit && "$mode" != pre-push ]]; then
  printf '使い方: %s (pre-commit|pre-push)\n' "$(basename "$0")" >&2
  exit 2
fi

config_dir="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles"
# 非公開側で配置。1 行 1 固定文字列、大小文字は区別しない
denylist_file="$config_dir/denylist.txt"
public_url_origins_file="$config_dir/public-url-origins.txt"
# 全 remote・push 先が業務用パターンに一致すれば検査を省略
work_remotes_file="$config_dir/work-remotes.txt"

[[ -r "$denylist_file" ]] || exit 0

# 前後空白・コメント・空行を除去（空パターンの全行一致を防ぐ）
strip_pattern_file() {
  sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -- "$1" |
    grep -v -e '^#' -e '^$' || true
}

# ディスクに残さず渡す非公開パターンの取得
patterns() {
  strip_pattern_file "$denylist_file"
}

if [[ -z "$(patterns)" ]]; then
  exit 0
fi

# 公開 URL ホストを除外し、禁止文字列のある元の行を出力
filter_public_origins() {
  if [[ ! -r "$public_url_origins_file" ]]; then
    cat
    return
  fi

  awk -v mode="$mode" '
    FILENAME == ARGV[1] {
      origin = tolower($0)
      if (origin !~ /^https:\/\/[a-z0-9]([a-z0-9.-]*[a-z0-9])?$/) {
        print "error: public-url-origins.txt は https://host 形式で指定してください" > "/dev/stderr"
        exit 2
      }
      origins[++origin_count] = origin
      next
    }
    FILENAME == ARGV[2] {
      denied[++deny_count] = tolower($0)
      next
    }
    {
      text = tolower($0)
      for (i = 1; i <= origin_count; i++) {
        origin = origins[i]
        offset = 1
        while ((position = index(substr(text, offset), origin)) > 0) {
          position += offset - 1
          before = position == 1 ? "" : substr(text, position - 1, 1)
          after = substr(text, position + length(origin), 1)
          # 差分の +/- 直後も行頭とみなす
          at_start = position == 1 ||
            (mode == "pre-push" && position == 2 && before ~ /^[+-]$/)
          if ((at_start || before ~ /[[:space:]]/ || index("<>\"\047`([{=:", before)) &&
              (after == "" || after ~ /[[:space:]]/ || index("/?#<>\"\047`)]}", after))) {
            text = substr(text, 1, position - 1) "https:// " substr(text, position + length(origin))
            offset = position + length("https:// ")
          } else {
            offset = position + length(origin)
          }
        }
      }
      for (i = 1; i <= deny_count; i++) {
        if (index(text, denied[i])) {
          print $0
          break
        }
      }
    }
  ' <(strip_pattern_file "$public_url_origins_file") <(patterns) -
}

# symlink を解決した絶対パスを取得
resolve_path() {
  local path="$1"
  local target dir

  while [[ -L "$path" ]]; do
    target="$(readlink "$path")" || return 1
    if [[ "$target" == /* ]]; then
      path="$target"
    else
      path="$(dirname "$path")/$target"
    fi
  done

  dir="$(cd -P -- "$(dirname "$path")" 2>/dev/null && pwd)" || return 1
  printf '%s/%s\n' "$dir" "$(basename "$path")"
}

# パターン自身が一致する配置元リポジトリは検査を省略
denylist_source="$(resolve_path "$denylist_file" 2>/dev/null || true)"
current_repo="$(git rev-parse --show-toplevel 2>/dev/null || true)"
denylist_repo=
if [[ -n "$denylist_source" ]]; then
  denylist_repo="$(
    git -C "$(dirname "$denylist_source")" rev-parse --show-toplevel 2>/dev/null ||
      true
  )"
fi
if [[ -n "$current_repo" && -n "$denylist_repo" ]]; then
  current_repo="$(cd -P -- "$current_repo" 2>/dev/null && pwd)"
  denylist_repo="$(cd -P -- "$denylist_repo" 2>/dev/null && pwd)"
  [[ "$current_repo" == "$denylist_repo" ]] && exit 0
fi

# 全 remote・push 先の業務用パターン一致を確認
is_work_repository() {
  local url has_remote=0

  [[ -r "$work_remotes_file" ]] || return 1
  [[ -n "$(strip_pattern_file "$work_remotes_file")" ]] || return 1

  if [[ "$mode" == pre-push ]]; then
    [[ -n "$remote_url" ]] || return 1
    printf '%s\n' "$remote_url" |
      grep -qiF -f <(strip_pattern_file "$work_remotes_file") || return 1
  fi

  while IFS= read -r url; do
    [[ -n "$url" ]] || continue
    printf '%s\n' "$url" |
      grep -qiF -f <(strip_pattern_file "$work_remotes_file") || return 1
    has_remote=1
  done < <(git remote -v 2>/dev/null | awk '{ print $2 }' | sort -u)

  ((has_remote))
}

if is_work_repository; then
  exit 0
fi

found=0

# 一致行を見出し付きで表示し、検出を記録
report() {
  local heading="$1"
  local line

  printf 'denylist: %s\n' "$heading" >&2
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    if ((${#line} > 200)); then
      line="${line:0:200}..."
    fi
    printf '  %s\n' "$line" >&2
  done
  found=1
}

# ステージ済みのパス・内容を検査
scan_pre_commit() {
  local -a paths=()
  local path hit

  while IFS= read -r -d '' path; do
    paths+=("$path")
  done < <(git diff --cached --name-only --diff-filter=ACMR -z)

  ((${#paths[@]} > 0)) || return 0

  hit="$(
    printf '%s\n' "${paths[@]}" | grep -iF -f <(patterns) || true
  )"
  [[ -n "$hit" ]] && report 'ステージ済みのパス名が一致しました' <<<"$hit"

  # 差分だけでなく index のファイル全体を検査
  hit="$(
    {
      git grep --cached --no-color -I -n -i -F -f <(patterns) -- "${paths[@]}" ||
        [[ $? == 1 ]]
    } | filter_public_origins
  )" || return 1
  [[ -n "$hit" ]] && report 'ステージ済みの内容が一致しました' <<<"$hit"

  return 0
}

# push 対象コミットを検査
scan_pre_push() {
  local _local_ref local_sha _remote_ref remote_sha
  local -a range remote_tips
  local commit hit count commits tips

  while read -r _local_ref local_sha _remote_ref remote_sha; do
    [[ -n "${local_sha:-}" ]] || continue
    # 0 SHA（ref 削除）は対象外
    [[ "$local_sha" =~ ^0+$ ]] && continue

    if [[ "${remote_sha:-}" =~ ^0+$ ]]; then
      # fetch・実送信先が同じ remote の履歴だけ除外
      # --remotes は private 履歴の public 初回 push を見逃す
      remote_tips=()
      if [[ -n "$remote_name" && -n "$remote_url" ]] &&
        [[ "$(git remote get-url "$remote_name" 2>/dev/null)" == "$remote_url" ]]; then
        tips="$(git for-each-ref --format='%(objectname)' \
          "refs/remotes/$remote_name/" 2>/dev/null)" || return 1
        while IFS= read -r commit; do
          [[ -n "$commit" ]] && remote_tips+=("$commit")
        done <<<"$tips"
      fi
      range=("$local_sha")
      ((${#remote_tips[@]} == 0)) || range+=(--not "${remote_tips[@]}")
    else
      range=("$remote_sha..$local_sha")
    fi

    count="$(git rev-list --count "${range[@]}" 2>/dev/null)" || return 1
    if ((count > 1000)); then
      printf 'denylist: %s 件のコミットを検査します (時間がかかります)\n' \
        "$count" >&2
    fi

    # 途中で削除された内容も検出するため各コミットを検査
    commits="$(git rev-list "${range[@]}" 2>/dev/null)" || return 1
    while IFS= read -r commit; do
      [[ -n "$commit" ]] || continue
      hit="$(
        git show --format='%B' -U0 --no-color --no-ext-diff --no-textconv \
          "$commit" -- 2>/dev/null |
          { grep -iF -f <(patterns) || [[ $? == 1 ]]; } |
          filter_public_origins
      )" || return 1
      [[ -n "$hit" ]] &&
        report "コミット ${commit:0:12} の内容が一致しました" <<<"$hit"
    done <<<"$commits"
  done

  return 0
}

case "$mode" in
pre-commit)
  if ! scan_pre_commit; then
    printf 'denylist: ステージ済み内容の取得または検査に失敗したため、commit を中止します。\n' >&2
    exit 1
  fi
  ;;
pre-push)
  if ! scan_pre_push; then
    printf 'denylist: 履歴の取得または検査に失敗したため、push を中止します。\n' >&2
    exit 1
  fi
  ;;
esac

if ((found)); then
  printf '\n' >&2
  printf 'このリポジトリへ入れてはいけない文字列が含まれています。\n' >&2
  printf '判定パターンは %s で確認できます。\n' "$denylist_file" >&2
  printf '意図した内容であれば、パターン側を見直してください。\n' >&2
  exit 1
fi

exit 0
