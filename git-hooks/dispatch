#!/usr/bin/env bash
# core.hooksPath から secretlint → denylist → .git/hooks → Git LFS の順に実行し、失敗を伝播する。
# core.hooksPath で参照されなくなる .git/hooks も、ここで引き継ぐ。
# pre-commit などのフック名で symlink を張る（$0 のファイル名で判定）。

set -uo pipefail

hook_name="$(basename "$0")"

# worktree でも共通の hooks ディレクトリを見る
git_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
[[ -n "$git_dir" ]] || git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
local_hook="${git_dir:-.git}/hooks/${hook_name}"

lfs_hooks=' pre-push post-checkout post-commit post-merge '

# 小さな ref 一覧を変数で保持し、複数フックへ同じ標準入力を渡す
stdin_hooks=' pre-push post-rewrite '

stdin_data=
stdin_captured=0
if [[ "$stdin_hooks" == *" $hook_name "* ]] && [[ ! -t 0 ]]; then
  stdin_data="$(cat)"
  stdin_captured=1
fi

run_with_stdin() {
  if ((stdin_captured)); then
    if [[ -n "$stdin_data" ]]; then
      printf '%s\n' "$stdin_data" | "$@"
    else
      "$@" </dev/null
    fi
  else
    "$@"
  fi
}

# IGNORE_GLOBAL_HOOKS に列挙されたリポジトリでは、secretlint と denylist だけを省略する。
# リポジトリ固有・LFS フックは、既存動作や LFS ファイルを壊さないよう継続する。
hooks_dir="$(cd "$(dirname "$0")" && pwd)"
ignore_file="$(dirname "$hooks_dir")/IGNORE_GLOBAL_HOOKS"
git_root="$(git rev-parse --show-superproject-working-tree 2>/dev/null || true)"
[[ -n "$git_root" ]] ||
  git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
skip_global_checks=0
if [[ -f "$ignore_file" && -n "$git_root" ]] &&
  grep -qF -- "$git_root" "$ignore_file"; then
  skip_global_checks=1
fi

# index 上の blob を secretlint で検査し、秘密値がエラーやデバッグ出力に出ないよう全出力を抑止する
if ((!skip_global_checks)) && [[ "$hook_name" == pre-commit ]]; then
  if ! command -v secretlint >/dev/null 2>&1; then
    printf 'error: secretlint が見つかりません\n' >&2
    printf '       mise install aqua:secretlint/secretlint で導入してから、もう一度コミットしてください\n' >&2
    exit 1
  fi

  secretlint_config='{"rules":[{"id":"@secretlint/secretlint-rule-preset-recommend"}]}'
  # 空コミットや削除のみの変更でも、実行・設定・ルール読み込みの失敗を止める
  if ! secretlint --secretlintrcJSON "$secretlint_config" --maskSecrets \
    --stdinFileName=secretlint-preflight </dev/null >/dev/null 2>&1; then
    printf 'error: secretlint を実行できません。導入状態とフック内の設定を確認してください\n' >&2
    exit 1
  fi

  if ! {
    # rename を追加と削除に分け、各レコードのパスを 1 個に揃える
    git --no-replace-objects diff --cached --raw --no-abbrev --no-renames --diff-filter=d \
      --no-ext-diff --no-textconv --no-color -z |
      while IFS= read -r -d '' entry; do
        IFS= read -r -d '' path || exit 1
        IFS=' ' read -r _old_mode new_mode _old_oid new_oid _change_type <<<"$entry" || exit 1
        case "$new_mode" in
        160000) continue ;; # submodule のコミット参照は blob ではない
        100644 | 100755 | 120000) ;;
        *) exit 1 ;;
        esac

        # symlink も blob の文字列だけを検査し、作業ツリーのリンク先は読まない
        git --no-replace-objects cat-file blob "$new_oid" |
          secretlint --secretlintrcJSON "$secretlint_config" --maskSecrets \
            --stdinFileName="./$path" || exit $?
      done
  } >/dev/null 2>&1; then
    printf 'error: ステージ済み内容で秘密情報を検出したか、読み出し・secretlint 検査に失敗しました\n' >&2
    printf '       秘密値の漏出を防ぐため、検査の詳細出力は表示していません\n' >&2
    exit 1
  fi
fi

deny_private_strings="$(dirname "$0")/deny-private-strings"
if ((!skip_global_checks)) &&
  [[ "$hook_name" == pre-commit || "$hook_name" == pre-push ]] &&
  [[ -x "$deny_private_strings" ]]; then
  run_with_stdin "$deny_private_strings" "$hook_name" "$@" || exit $?
fi

if [[ -x "$local_hook" ]]; then
  run_with_stdin "$local_hook" "$@" || exit $?
fi

if [[ "$lfs_hooks" == *" $hook_name "* ]] &&
  command -v git-lfs >/dev/null 2>&1; then
  run_with_stdin git lfs "$hook_name" "$@" || exit $?
fi
