#!/usr/bin/env bash
#
# ============================================================================
# core.hooksPath 用のフック振り分けスクリプト
# ============================================================================
#
# core.hooksPath を設定すると、Git は各リポジトリの .git/hooks を参照しなくなる。
# そのため、このスクリプトがフック名ごとに以下を順に実行し、失敗を伝播する。
#
#   1. 非公開 denylist の検査 (pre-commit / pre-push のみ)
#   2. リポジトリ固有フック (.git/hooks/<フック名>)
#   3. Git LFS のフック (git-lfs 導入済みかつ LFS が扱うフック名の場合)
#
# フック名は $0 のファイル名から決まるため、pre-push などの名前でこのスクリプトへ
# シンボリックリンクを張って使う。pre-commit は secretlint のフックへ直接リンクし、
# そこから git-hooks/_local-hook-exec 経由で 1. が実行される。

set -uo pipefail

hook_name="$(basename "$0")"

# worktree でも共通の hooks ディレクトリを見る
git_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
[[ -n "$git_dir" ]] || git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
local_hook="${git_dir:-.git}/hooks/${hook_name}"

# Git LFS が各リポジトリに設置するフック
lfs_hooks=' pre-push post-checkout post-commit post-merge '

# 標準入力で情報を受け取るフック (複数の実行先へ渡せるよう内容を保持する)。
# 内容は ref の一覧など小さな行データなので、一時ファイルを使わず変数に読み込む
stdin_hooks=' pre-push post-rewrite '

stdin_data=
stdin_captured=0
if [[ "$stdin_hooks" == *" $hook_name "* ]] && [[ ! -t 0 ]]; then
  stdin_data="$(cat)"
  stdin_captured=1
fi

# 保持した標準入力があれば、それを与えて実行する
run_with_stdin() {
  if ((stdin_captured)); then
    if [[ -n "$stdin_data" ]]; then
      printf '%s\n' "$stdin_data" | "$@"
    else
      "$@" </dev/null
    fi
  else
    "$@"
  fi
}

# 上流互換: IGNORE_GLOBAL_HOOKS に列挙されたリポジトリでは、
# グローバルに追加した検査 (denylist) を行わない。
# リポジトリ固有フックと Git LFS のフックは、そのリポジトリの動作そのものに
# 必要なため続行する (止めると LFS のファイルが壊れる)
hooks_dir="$(cd "$(dirname "$0")" && pwd)"
ignore_file="$(dirname "$hooks_dir")/IGNORE_GLOBAL_HOOKS"
git_root="$(git rev-parse --show-superproject-working-tree 2>/dev/null || true)"
[[ -n "$git_root" ]] ||
  git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
skip_global_checks=0
if [[ -f "$ignore_file" && -n "$git_root" ]] &&
  grep -qF -- "$git_root" "$ignore_file"; then
  skip_global_checks=1
fi

# 1. 非公開 denylist の検査。
# pre-commit が secretlint のフックへ張られている場合はこちらを通らないため、
# 同じ検査を git-hooks/_local-hook-exec 側にも置いてある (二重実行はしない)
deny_private_strings="$(dirname "$0")/deny-private-strings"
if ((!skip_global_checks)) &&
  [[ "$hook_name" == pre-commit || "$hook_name" == pre-push ]] &&
  [[ -x "$deny_private_strings" ]]; then
  run_with_stdin "$deny_private_strings" "$hook_name" "$@" || exit $?
fi

# 2. リポジトリ固有フック (失敗したらその終了状態で中断する)
if [[ -x "$local_hook" ]]; then
  run_with_stdin "$local_hook" "$@" || exit $?
fi

# 3. Git LFS のフック
if [[ "$lfs_hooks" == *" $hook_name "* ]] &&
  command -v git-lfs >/dev/null 2>&1; then
  run_with_stdin git lfs "$hook_name" "$@" || exit $?
fi
