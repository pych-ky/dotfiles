#!/usr/bin/env bash
#
# ============================================================================
# リポジトリ固有フックを実行する共通処理 (secretlint の pre-commit から source)
# ============================================================================
#
# secretlint/git-hooks の pre-commit は `source $(dirname $0)/_local-hook-exec` を
# 行うため、pre-commit をこのディレクトリ経由で実行すると本ファイルが読まれる。
#
# 上流の同名ファイルはリポジトリ固有フックの終了状態を捨てており、固有フックが
# コミットを拒否しても成立してしまう。ここでは失敗をそのまま伝播する。
#
# source される前提のため set -e は使わない (呼び出し元を巻き込むため)。

__dotfiles_hook_name="$(basename "$0")"

# 上流互換: IGNORE_GLOBAL_HOOKS に列挙されたリポジトリではグローバルフックを行わない。
# リポジトリ固有フックは、そのリポジトリの動作そのものなので後段で引き続き実行する。
__dotfiles_hooks_dir="$(cd "$(dirname "$0")" && pwd)"
__dotfiles_ignore_file="$(dirname "$__dotfiles_hooks_dir")/IGNORE_GLOBAL_HOOKS"
__dotfiles_git_root="$(
  git rev-parse --show-superproject-working-tree 2>/dev/null || true
)"
[[ -n "$__dotfiles_git_root" ]] ||
  __dotfiles_git_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
__dotfiles_skip_global_checks=0
if [[ -f "$__dotfiles_ignore_file" && -n "$__dotfiles_git_root" ]] &&
  grep -qF -- "$__dotfiles_git_root" "$__dotfiles_ignore_file"; then
  __dotfiles_skip_global_checks=1
fi

# 非公開 denylist の検査。
# pre-commit が dispatch へ張られている場合は dispatch 側で行うため、
# ここでは secretlint 経由の pre-commit だけを担当する (二重実行はしない)
__dotfiles_deny_private_strings="$(dirname "$0")/deny-private-strings"
if ((!__dotfiles_skip_global_checks)) &&
  [[ "$__dotfiles_hook_name" == pre-commit &&
  -x "$__dotfiles_deny_private_strings" ]]; then
  "$__dotfiles_deny_private_strings" pre-commit || exit $?
fi

# worktree でも共通の hooks ディレクトリを見る
__dotfiles_git_dir="$(git rev-parse --git-common-dir 2>/dev/null || true)"
[[ -n "$__dotfiles_git_dir" ]] ||
  __dotfiles_git_dir="$(git rev-parse --git-dir 2>/dev/null || true)"
__dotfiles_local_hook="${__dotfiles_git_dir:-.git}/hooks/${__dotfiles_hook_name}"

# リポジトリ固有フックがあれば実行し、失敗したらその終了状態で中断する
if [[ -x "$__dotfiles_local_hook" ]]; then
  "$__dotfiles_local_hook" "$@" || exit $?
fi

((__dotfiles_skip_global_checks)) && exit 0

# ----------------------------------------------------------------------------
# secretlint の実行前提の検査
# ----------------------------------------------------------------------------
#
# 上流の pre-commit は、ステージ内容を一時ディレクトリへ複製してから docker で
# secretlint を実行する。ただし `mktemp -d` の失敗も、複製 (git show の
# リダイレクト) の失敗も検査しない。そのため一時ディレクトリが作れない環境では
# `mkdir: /tests: Operation not permitted` のような原因の分からないエラーになり、
# 複製が部分的に失敗した場合は「ステージした一部だけを検査して成功」になりうる。
#
# 秘密情報の検査が漏れたままコミットさせないため、前提が揃わない時点で中断する。
#
# 呼び出し元が docker を使う実装かどうかは、そのスクリプト自身を見て判定する
# (docker を使わない pre-commit にまで docker を要求しないため)。
__dotfiles_caller_uses_docker=0
if [[ -r "$0" ]] && grep -qE 'docker[[:space:]]+run' -- "$0" 2>/dev/null; then
  __dotfiles_caller_uses_docker=1
fi

if [[ "$__dotfiles_hook_name" == pre-commit ]] &&
  ((__dotfiles_caller_uses_docker)) &&
  [[ -n "$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null)" ]]; then

  # よくある原因 (Rancher Desktop 未起動) から先に検査する
  if ! command -v docker >/dev/null 2>&1; then
    printf 'error: docker が見つかりません\n' >&2
    printf '       secretlint のフックは docker で実行されます。\n' >&2
    printf '       Rancher Desktop を起動し、~/.rd/bin が PATH にあるか確認してください\n' >&2
    exit 1
  fi

  if ! docker version --format '{{.Server.Version}}' >/dev/null 2>&1; then
    printf 'error: docker デーモンへ接続できません\n' >&2
    printf '       Rancher Desktop を起動してから、もう一度コミットしてください\n' >&2
    exit 1
  fi

  # macOS の mktemp はテンプレートを省略すると TMPDIR ではなく
  # confstr(_CS_DARWIN_USER_TEMP_DIR) を使う。上流フックはそちらを使うため、
  # TMPDIR が書けても失敗しうる。実際に試して確認する
  __dotfiles_probe="$(mktemp -d 2>/dev/null || true)"
  if [[ -z "$__dotfiles_probe" || ! -d "$__dotfiles_probe" ]]; then
    printf 'error: 一時ディレクトリを作成できません\n' >&2
    printf '       secretlint はステージ内容を一時ディレクトリへ複製して検査します。\n' >&2
    printf '       検査漏れのままコミットさせないため、ここで中断します\n' >&2
    printf '       mktemp の作成先: %s (TMPDIR ではなくこちらを使います)\n' \
      "$(getconf DARWIN_USER_TEMP_DIR 2>/dev/null || printf '%s' "${TMPDIR:-/tmp}")" >&2
    exit 1
  fi
  rmdir -- "$__dotfiles_probe" 2>/dev/null || true
fi
